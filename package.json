{
  "name": "personal-scp-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/content.mjs generate && vite",
    "build": "npm run typecheck && npm run validate && node scripts/content.mjs generate && vite build",
    "preview": "vite preview",
    "assign-ids": "node scripts/content.mjs assign",
    "validate": "node scripts/content.mjs validate",
    "typecheck": "tsc --noEmit",
    "test:content": "node scripts/test-content-pipeline.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  }
}
